# Generate a ready-to-use .env with: node scripts/init-env.mjs
# Or copy this file to .env and fill in both required secrets below.

# Required secrets. Use random hexadecimal values (openssl rand -hex 32).
API_TOKEN=
POSTGRES_PASSWORD=

# Shared application settings. Enable secure cookies when serving over HTTPS.
COOKIE_SECURE=false
MAX_DOWNLOAD_MB=100
RUST_LOG=lewdarchive=info,tower_http=info

# RSSHub feed builder. Empty uses http://rsshub:1200 in Compose,
# or https://rsshub.app when running the backend outside Docker.
RSSHUB_BASE_URL=
# Exact comma-separated private hostnames allowed ONLY for fetching feeds.
# Compose already includes rsshub. Media downloads never use this exception.
ALLOW_PRIVATE_FEED_HOSTS=

# Native development only: Compose supplies its own connection and paths.
# Replace CHANGE_ME with POSTGRES_PASSWORD when configuring manually.
DATABASE_URL=postgres://lewdarchive:CHANGE_ME@localhost:5432/lewdarchive
BIND_ADDRESS=0.0.0.0:8080
DOWNLOAD_DIR=./data/downloads
FRONTEND_DIR=frontend/dist

# Optional Discord bot + community portal. Leave the token empty to disable.
# See docs/discord-bot.md for OAuth, interactions, permissions and commands.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=
# Public HTTPS origin, no trailing path; e.g. https://archive.example.com.
# Set COOKIE_SECURE=true in HTTPS deployments.
PUBLIC_BASE_URL=

# Optional Cloudflare Tunnel token for cloudflared service in Compose
# Start with: docker compose --profile tunnel up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=

# Optional local WD image tagging (CPU or CUDA). Leave URL empty to disable.
# For bundled service: WD_TAGGER_URL=http://tagger:5000
# Start with: docker compose --profile ai up -d --build app tagger
WD_TAGGER_URL=
WD_CPU_THREADS=2
WD_GENERAL_THRESHOLD=0.35
WD_CHARACTER_THRESHOLD=0.85
WD_MODEL_TTL=300
WD_DEVICE=cpu
